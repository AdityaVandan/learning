          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('bigBody')) {",
                  "  pm.collectionVariables.set('bigBody', 'x'.repeat(1100));",
                  "}"
                ]
              }
            }
          ],
          "request": {
