    {
      "name": "2xx Success",
      "item": [
        {
          "name": "GET /codes/200",
          "request": { "method": "GET", "url": "{{baseUrl}}/codes/200" }
        },
        {
          "name": "POST /codes/201 (Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const body = pm.response.json();",
                  "  if (body && body.id) pm.collectionVariables.set('createdItemId', body.id);",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"widget\"\n}" },
            "url": "{{baseUrl}}/codes/201"
          }
        },
        {
          "name": "GET /codes/201/items/{{createdItemId}}",
          "request": { "method": "GET", "url": "{{baseUrl}}/codes/201/items/{{createdItemId}}" }
        },
        {
          "name": "POST /codes/202 (Accepted / async job)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const body = pm.response.json();",
                  "  if (body && body.job_id) pm.collectionVariables.set('jobId', body.job_id);",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/codes/202" }
        },
        {
          "name": "GET /codes/202/jobs/{{jobId}}",
